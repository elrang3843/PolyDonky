<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PolyDonky.Convert.Doc</RootNamespace>
    <AssemblyName>PolyDonky.Convert.Doc</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PolyDonky.Core\PolyDonky.Core.csproj" />
    <ProjectReference Include="..\..\src\PolyDonky.Iwpf\PolyDonky.Iwpf.csproj" />
    <ProjectReference Include="..\..\src\PolyDonky.Codecs.Docx\PolyDonky.Codecs.Docx.csproj" />
    <ProjectReference Include="..\PolyDonky.Convert.Common\PolyDonky.Convert.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- OLE2 Compound File Binary parser — Word 97-2003 .doc 가 OLE2 컨테이너이므로 필요.
         RTF 경로(DocReader/DocWriter)는 쓰지 않지만, .doc → IWPF 의 DocBinaryReader 가 사용한다. -->
    <PackageReference Include="OpenMcdf" />
  </ItemGroup>

</Project>
