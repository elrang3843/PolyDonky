<?xml version="1.0" encoding="utf-8"?>
<!--
  이식형(Portable) 배포 프로파일 — 압축 해제 후 바로 실행 가능한 win-x64 ZIP 용.
  .NET 10 별도 설치 불필요. CLI 변환기(PolyDonky.Convert.*)도 함께 게시된다.

  빠른 빌드:
    dotnet publish src/PolyDonky.App -p:PublishProfile=Portable

  ZIP 생성 (scripts/publish-portable.ps1 권장):
    pwsh scripts/publish-portable.ps1
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDir>..\..\publish\PolyDonky-win-x64\</PublishDir>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
